{
  "name": "powerspark-panel",
  "version": "0.1.0",
  "private": true,
  "description": "PowerSpark Panel - Minecraft server hosting control panel monorepo",
  "scripts": {
    "dev:web": "pnpm --filter @powerspark/web dev",
    "dev:api": "pnpm --filter @powerspark/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prisma:generate": "pnpm --filter @powerspark/api prisma generate",
    "prisma:migrate": "pnpm --filter @powerspark/api prisma migrate dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "typescript-eslint": "^8.13.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
