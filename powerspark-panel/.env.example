# ---------------------------------------------------------
# PowerSpark Panel - Environment Variable Template
# Copy this file to .env and fill in real values.
# ---------------------------------------------------------

# ---------- Database (PostgreSQL) ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/powerspark_panel?schema=public"

# ---------- API (apps/api) ----------
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# Origin allowed to make cross-site cookie-bearing requests to the API
# (must match the frontend's URL exactly, including protocol/port).
CLIENT_URL="http://localhost:3000"

# ---------- Authentication ----------
# Generate strong random secrets, e.g.: openssl rand -hex 32
# Never reuse these values, and never commit real secrets to git.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---------- Reserved for future features (not used yet) ----------
# EMAIL_FROM=
# EMAIL_PROVIDER_API_KEY=
# MINECRAFT_SERVERS_ROOT=
